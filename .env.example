# PayPal sandbox app credentials
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" or "live". Keep this on sandbox for the hackathon.
PAYPAL_ENV=sandbox

# Public URL of this app. Must be HTTPS for the PayPal approval redirect.
# Local dev can stay on http://localhost:3000 for API testing, but use your
# Vercel URL when demoing the full approve -> capture flow.
APP_URL=http://localhost:3000

# Optional: enables the Agent Toolkit (agent picks the item).
# Without it, the app uses the deterministic safe-checkout path.
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini

# Set to 1 to force the deterministic path (great demo fallback).
AGENT_DISABLED=
